# --- Agent workspace -------------------------------------------------------
# Never committed here: it is its own private repository
# (inklikeurine/userscripts-dev: tools, harness, tests, journals, notes,
# throwaway Firefox profiles, harness output). See AGENTS.md → "Agent workspace".
.dev/

# --- Operating system ------------------------------------------------------
.DS_Store
._*
.AppleDouble
Thumbs.db
Desktop.ini
*~

# --- Editors / IDEs --------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# --- AI agent state --------------------------------------------------------
# .claude/settings.json (hook + permissions) and CLAUDE.md are committed on
# purpose: a fresh clone keeps its guard rail. Per-user files are not.
.claude/*
!.claude/settings.json
CLAUDE.local.md
.cursor/
.aider*

# --- Node (never at the repo root; .dev/ has its own) ----------------------
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Playwright / browser artifacts ----------------------------------------
test-results/
playwright-report/
*.har
*.trace.zip

# --- Secrets / env ---------------------------------------------------------
.env
.env.*
!.env.example

# --- Misc ------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
