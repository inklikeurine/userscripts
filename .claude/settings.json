{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node .dev/tools/*)",
      "Bash(node .dev/harness/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.dev/tools/on-edit.mjs\" ]; then node \"$CLAUDE_PROJECT_DIR/.dev/tools/on-edit.mjs\"; fi",
            "timeout": 30,
            "statusMessage": "Validating userscripts…"
          }
        ]
      }
    ]
  }
}
